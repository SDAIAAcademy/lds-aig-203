# Text is stored and checked out with LF on every platform: the build compares bytes, and a
# notebook with CRLF line endings does not open in every tool.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.pdf binary
*.woff2 binary
*.xlsx binary
*.docx binary
*.pptx binary
*.parquet binary

# The signed model package of lab 1.2 and its mirror copy: bytes must never change on checkout,
# or the signature check fails for the wrong reason
labs/files/sutur-ocr-small/** -text
labs/files/mirror/** -text
labs/files/signatures/** -text
*.safetensors binary
